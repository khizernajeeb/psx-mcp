# Long random string; becomes part of your connector URL. Keep it private.
MCP_SECRET=replace-with-a-long-random-string

# Neon Postgres pooled connection string (Vercel Marketplace -> Neon -> copy
# the "pooled connection" string, not the direct one). Needed for watchlist,
# alerts and everything else in psx_mcp/repository.py.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# Long random string, checked against the X-Cron-Secret header on
# POST /api/cron/check-alerts. Set the same value as a GitHub Actions secret.
CRON_SECRET=replace-with-a-different-long-random-string

# Telegram bot used to deliver alert events. Create a bot with @BotFather to
# get the token; message the bot once, then GET
# https://api.telegram.org/bot<token>/getUpdates to find your chat_id.
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
TELEGRAM_CHAT_ID=replace-with-your-chat-id
